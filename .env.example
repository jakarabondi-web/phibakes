# PhiBakes — environment variables
# Copy this file to .env (or .env.local) and fill in real values for each integration
# you want to go live. Every route handler under src/app/api/ degrades gracefully
# (mock data / simulation mode) when a given variable is left unset, so you can deploy
# incrementally.

# --- Database (Prisma / Neon Postgres) ------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/phibakes?schema=public" # Prisma datasource connection string

# --- M-PESA Daraja (Safaricom) — see src/lib/services/mpesa.ts ------------------------
MPESA_CONSUMER_KEY=        # Daraja app Consumer Key (developer.safaricom.co.ke)
MPESA_CONSUMER_SECRET=     # Daraja app Consumer Secret
MPESA_SHORTCODE=           # Lipa Na M-PESA Online Paybill/Till shortcode
MPESA_PASSKEY=             # Lipa Na M-PESA Online Passkey issued for the shortcode
MPESA_CALLBACK_URL=        # Public HTTPS URL Safaricom POSTs results to, e.g. https://phibakes.co.ke/api/mpesa/callback
MPESA_ENV=sandbox          # "sandbox" | "production" — selects the Daraja API base URL

# --- Email (Resend) — see src/lib/services/email.ts -----------------------------------
RESEND_API_KEY=            # API key from the Resend dashboard (resend.com)

# --- SMS + WhatsApp (Twilio) — see src/lib/services/sms.ts ----------------------------
TWILIO_ACCOUNT_SID=        # Twilio Account SID
TWILIO_AUTH_TOKEN=         # Twilio Auth Token
TWILIO_FROM_NUMBER=        # Twilio phone number for plain SMS, e.g. +15551234567
TWILIO_WHATSAPP_FROM=      # Twilio WhatsApp-enabled sender, e.g. whatsapp:+14155238886

# --- Maps (Google Maps JS API) ---------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY= # Used client-side for delivery address picking/zone maps

# --- File storage (Cloudflare R2) ------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=       # Cloudflare account ID that owns the R2 bucket
CLOUDFLARE_R2_ACCESS_KEY_ID=    # R2 S3-compatible API access key ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY= # R2 S3-compatible API secret access key
CLOUDFLARE_R2_BUCKET_NAME=      # Bucket name storing reference images / uploads
CLOUDFLARE_R2_PUBLIC_URL=       # Public base URL (custom domain or r2.dev) for serving uploaded assets
